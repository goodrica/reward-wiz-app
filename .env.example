# Plaid (sandbox prototype)
# Get these from https://dashboard.plaid.com/team/keys after signing up
# (free; the Trial plan covers up to 10 connected production items).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# NOTE: these names intentionally have no VITE_ prefix so Vite keeps them
# server-side only. Server functions read them via import.meta.env.
